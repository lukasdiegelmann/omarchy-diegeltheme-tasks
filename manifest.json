{
  "schemaVersion": 1,
  "id": "diegeltheme.bar.tasks",
  "name": "Tasks",
  "version": "1.0.0",
  "author": "Lukas Diegelmann",
  "description": "Open windows as icons, grouped by workspace",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Tasks.qml"
  },
  "barWidget": {
    "displayName": "Tasks",
    "description": "Open windows as icons, grouped by workspace",
    "category": "Compositor",
    "allowMultiple": false,
    "defaults": {
      "scope": "all",
      "iconSize": 22,
      "showWorkspace": false
    },
    "schema": [
      {
        "key": "scope",
        "type": "string",
        "label": "Scope: workspace | all"
      },
      {
        "key": "iconSize",
        "type": "number",
        "label": "Icon size in px"
      },
      {
        "key": "showWorkspace",
        "type": "boolean",
        "label": "Show the workspace number per group"
      }
    ]
  }
}